  <sharedRules>
    <rule name="Ruthless" id="ed89-32dc-a035-2346" hidden="false" publicationId="af58-47f6-82b8-3f00" page="53">
      <description>Squads with a Ruthless Leader do not roll Bad Things Happen for harming a Civilian. This effect is removed as soon as the Ruthless Leader is removed.</description>
    </rule>
