<catalogue library="false" id="3953-d0d7-b095-29a2" name="Pacific Heat - British Empire" gameSystemId="sys-b77d-188a-67ba-264e" gameSystemRevision="1" revision="1" battleScribeVersion="2.03" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <sharedRules>
    <rule name="Furious Charge" id="9d44-60f1-cfa9-1573" hidden="false" publicationId="21ee-01ed-7eb0-72c8" page="16">
      <description>If a Furious Charge model moves into Melee, during their first round of combat, any 4s they roll count as Hits and are compared to 5s and 6s for Critical Hits.</description>
    </rule>
  </sharedRules>
