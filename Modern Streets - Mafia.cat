  <sharedRules>
    <rule name="Cunning Plan" id="9fbe-784f-c792-503d" hidden="false" page="92" publicationId="af58-47f6-82b8-3f00">
      <description>Squads led by this model add +2 to all its members&apos; Rank when determining both their starting Squad Morale and the number of Stars in the Game Deck.  In-game Ranks are unaffected.</description>
    </rule>
  </sharedRules>
