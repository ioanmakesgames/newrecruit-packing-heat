  <sharedRules>
    <rule name="Local Legends" id="e654-ea2e-a577-0872" hidden="false">
      <description>Civilians will NOT stop this Faction&apos;s models from Shooting.  If they get involved in a Melee involving these models, instead of halving both dice pools, they only halve the opponent&apos;s pool.</description>
    </rule>
    <rule name="Firebrand" id="0589-c903-8aa1-2ec9" hidden="false">
      <description>If a Squad mostly consists of Firebrands, roll for their starting Squad Morale with a D6+2, as if they were all Rank 4. If I measured that stat based on spirit alone, they absolutely would be!</description>
    </rule>
  </sharedRules>
  <sharedProfiles>
    <profile name="Civilian Support" typeId="9881-5d02-6f57-bc65" typeName="Squad Support" hidden="false" id="61f7-dd32-b7a3-0ebe">
      <characteristics>
        <characteristic name="Description" typeId="e807-c516-44d2-4199">After placing their Jump-Offs, the Resistance player places the Civilian(s) anywhere on the battlefield.  The opposing player then moves the Civilian(s) up to 1D6” in any direction of their choice. They may not be moved off the battlefield this way.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
