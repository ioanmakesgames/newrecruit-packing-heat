<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue library="false" id="fcf9-72d9-e45e-da3e" name="Pacific Heat - Imperial Japan" gameSystemId="sys-b77d-188a-67ba-264e" gameSystemRevision="1" revision="1" battleScribeVersion="2.03" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <catalogueLinks>
    <catalogueLink type="catalogue" name="WW2 Shared Data" id="0a79-8dcf-4f2e-1c94" targetId="f8b3-af32-e87b-94d1"/>
  </catalogueLinks>
  <sharedRules>
    <rule name="Banzai!" id="19b2-a415-ca3f-508e" hidden="false" publicationId="21ee-01ed-7eb0-72c8" page="10">
      <description>If this is the Active Model of a Group Movement add an extra 1D6&quot; to distance.  Additionally, may select Shaken and Suppressed models to join them.</description>
    </rule>
    <rule name="Kishu" id="8a9e-d83f-7856-5438" hidden="false" publicationId="21ee-01ed-7eb0-72c8" page="10">
      <description>If a Squad Leader declares a Group Action while a Kishu is in their Command Radius, they may join in without it counting towards follower limit.  If they do, you may select followers from within the Kishu&apos;s Command Radius and may add additional followers up to the Kishu&apos;s Rank.</description>
    </rule>
  </sharedRules>
  <sharedProfiles>
    <profile name="Squad Bicycles" typeId="9881-5d02-6f57-bc65" typeName="Squad Support" hidden="false" id="526d-f3a5-b2d8-ffda" publicationId="21ee-01ed-7eb0-72c8" page="10">
      <characteristics>
        <characteristic name="Description" typeId="e807-c516-44d2-4199">Once per Turn, a Squad with Bicycles may spend 2 Stars to move one of their Jump-Offs – roll 3D6, discard the lowest die, and move it that many inches in any direction. Jump-Offs must end their movement at least 6” away from enemies and at least 9” away from enemy Jump-Offs.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
