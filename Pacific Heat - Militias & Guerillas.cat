  </catalogueLinks>
  <categoryEntries>
    <categoryEntry name="Firebrand" id="3361-493b-b77e-2296" hidden="false"/>
  </categoryEntries>
  <sharedRules>
    <rule name="Firebrand" id="4c86-6881-50e6-5111" hidden="false">
      <description>If a Squad mostly consists of Firebrands, roll for their starting Squad Morale with a D6+2, as if they were all Rank 4. If I measured that stat based on spirit alone, they absolutely would be!</description>
    </rule>
    <rule name="Local Legends" id="8ea3-2b1c-8e37-a449" hidden="false">
      <description>Civilians will NOT stop this Faction&apos;s models from Shooting.  If they get involved in a Melee involving these models, instead of halving both dice pools, they only halve the opponent&apos;s pool.</description>
    </rule>
  </sharedRules>
